[Unit]
Description=SafexCash pool: stratum server (miners, share checking with the rxhash helper, block submission)
After=sfx-pool-redis.service sfx-node.service sfx-wallet-rpc.service
Requires=sfx-pool-redis.service
[Service]
Type=simple
User=sfxpool
WorkingDirectory=/opt/safex-nodejs-pool
ExecStart=/usr/bin/node /opt/safex-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
