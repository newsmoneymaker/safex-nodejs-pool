[Unit]
Description=SafexCash pool: block unlocker (credits the miners after the coinbase maturity)
After=sfx-pool-redis.service sfx-node.service sfx-wallet-rpc.service
Requires=sfx-pool-redis.service
[Service]
Type=simple
User=sfxpool
WorkingDirectory=/opt/safex-nodejs-pool
ExecStart=/usr/bin/node /opt/safex-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
