[Unit]
Description=SafexCash node (safexd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sfxpool
ExecStart=/opt/safex/bin/safexd --data-dir /opt/safex/data --non-interactive --rpc-bind-ip 127.0.0.1 --rpc-bind-port 17402 --p2p-bind-port 17401 --log-level 1 --max-log-file-size 0
Restart=on-failure
RestartSec=15
LimitNOFILE=65536
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
