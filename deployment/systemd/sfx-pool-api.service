[Unit]
Description=SafexCash pool: public API (127.0.0.1:8134)
After=sfx-pool-redis.service sfx-node.service sfx-wallet-rpc.service
Requires=sfx-pool-redis.service
[Service]
Type=simple
User=sfxpool
WorkingDirectory=/opt/safex-nodejs-pool
ExecStart=/usr/bin/node /opt/safex-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
